{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yri-www",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "yri.ai", "custom_domain": true },
    { "pattern": "www.yri.ai", "custom_domain": true }
  ]
}
